# Server Configuration
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgres://[user]:[password]@[host]:[port]/[database]
# JWT Configuration
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRE=7d
REFRESH_TOKEN_EXPIRE=30d

# ===========================================
# FRONTEND URL - Automatically switches based on NODE_ENV
# ===========================================
# Development (default): http://localhost:3000
# Production: https://cosmoscraft.netlify.app
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_PROD=https://cosmoscraft.netlify.app

# ===========================================
# OAuth - Google
# ===========================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Development callback
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
# Production callback
GOOGLE_CALLBACK_URL_PROD=https://your-production-server.com/auth/google/callback

# ===========================================
# OAuth - Facebook
# ===========================================
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
# Development callback
FACEBOOK_CALLBACK_URL=http://localhost:5000/auth/facebook/callback
# Production callback
FACEBOOK_CALLBACK_URL_PROD=https://your-production-server.com/auth/facebook/callback

# ===========================================
# Email Service (Gmail)
# ===========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
# Use an App Password (not your regular password) if 2FA is enabled:
# https://myaccount.google.com/apppasswords
MAIL_PASS=your-app-password
# Gmail requires From to match the authenticated account (or a verified alias).
# If you set a custom domain here, you must add it as a verified alias in Gmail.
MAIL_FROM=your-email@gmail.com
# Prefer IPv4 DNS resolution (helps avoid IPv6 routing issues on cloud platforms)
MAIL_PREFER_IPV4=true
# Force IPv4 on the SMTP socket itself (belt-and-suspenders for ENETUNREACH on Render).
# Set to 'false' to disable and allow IPv6.
MAIL_FORCE_IPV4=true
# Optional: set to 'true' for port 465 (implicit TLS), 'false' for 587 (STARTTLS)
MAIL_SECURE=false
# Optional: connection/greeting/socket timeouts in ms
MAIL_CONNECTION_TIMEOUT=10000
MAIL_GREETING_TIMEOUT=5000
MAIL_SOCKET_TIMEOUT=10000
# Optional: number of send retries with backoff
MAIL_SEND_RETRIES=3
