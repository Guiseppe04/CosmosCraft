# Server Configuration
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgres://[user]:[password]@[host]:[port]/[database]
# JWT Configuration
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRE=7d
REFRESH_TOKEN_EXPIRE=30d

# ===========================================
# FRONTEND URL - Automatically switches based on NODE_ENV
# ===========================================
# Development (default): http://localhost:3000
# Production: https://cosmoscraft.netlify.app
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_PROD=https://cosmoscraft.netlify.app

# ===========================================
# OAuth - Google
# ===========================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Development callback
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
# Production callback (used automatically when NODE_ENV=production)
GOOGLE_CALLBACK_URL_PROD=https://your-production-server.com/auth/google/callback

# ===========================================
# OAuth - Facebook
# ===========================================
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
# Development callback
FACEBOOK_CALLBACK_URL=http://localhost:5000/auth/facebook/callback
# Production callback (used automatically when NODE_ENV=production)
# MUST match EXACTLY the "Valid OAuth Redirect URIs" in the Meta Developer Console,
# including trailing slash consistency.
FACEBOOK_CALLBACK_URL_PROD=https://your-production-server.com/auth/facebook/callback
# IMPORTANT: Also set FACEBOOK_CALLBACK_URL_PROD in Render's environment variables,
# and ensure the URL is whitelisted in Meta Developer Console > Facebook Login > Settings.

# ===========================================
# Email Service (Brevo)
# ===========================================
# Brevo transactional email API - preferred method
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM=noreply@cosmos-craft.com
MAIL_FROM_NAME=Cosmos Craft
# Optional: number of send retries with backoff
MAIL_SEND_RETRIES=3

# ===========================================
# Email Service (SMTP fallback)
# ===========================================
# Uncomment below to use SMTP instead of Brevo API
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=your-email@gmail.com
# MAIL_PASS=your-app-password
# If SMTP host resolves to IPv6 and your environment lacks IPv6 outbound support,
# set NODE_OPTIONS=--dns-result-order=ipv4first to force IPv4 DNS resolution.
