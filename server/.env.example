# Server Configuration
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgres://[user]:[password]@[host]:[port]/[database]
# JWT Configuration
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRE=7d
REFRESH_TOKEN_EXPIRE=30d

# ===========================================
# FRONTEND URL - Automatically switches based on NODE_ENV
# ===========================================
# Development (default): http://localhost:3000
# Production: https://cosmoscraft.netlify.app
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_PROD=https://cosmoscraft.netlify.app

# ===========================================
# OAuth - Google
# ===========================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Development callback
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
# Production callback
GOOGLE_CALLBACK_URL_PROD=https://your-production-server.com/auth/google/callback

# ===========================================
# OAuth - Facebook
# ===========================================
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
# Development callback
FACEBOOK_CALLBACK_URL=http://localhost:5000/auth/facebook/callback
# Production callback
FACEBOOK_CALLBACK_URL_PROD=https://your-production-server.com/auth/facebook/callback

# ===========================================
# Email Service (Brevo Transactional API)
# ===========================================
# Get your API key from Brevo dashboard: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key
# Sender email - must be on a domain verified in Brevo (Settings > Senders, Domains & Dedicated IPs > Domains)
MAIL_FROM=noreply@cosmos-craft.com
# Sender display name
MAIL_FROM_NAME=CosmosCraft
# Optional: number of send retries with backoff
MAIL_SEND_RETRIES=3
