# Server Configuration
NODE_ENV=development
PORT=5000
# In Coolify, the backend container must listen on all interfaces:
# HOST=0.0.0.0
# TRUST_PROXY=1

# Redis: leave empty for local development (no cache, per-process rate limits).
# In Coolify, paste the Redis resource's internal URL (same destination network).
# Example: redis://:URL_ENCODED_PASSWORD@redis-container-name:6379/0
REDIS_URL=
REDIS_KEY_PREFIX=cosmoscraft:

# Optional token-bucket tuning. A burst is available immediately; one token
# refills every *_REFILL_MS. Exceeding a bucket returns 429 with Retry-After.
# Keep the defaults unless real traffic data shows a need to change them.
# RATE_LIMIT_GUEST_BURST=80
# RATE_LIMIT_GUEST_REFILL_MS=500
# RATE_LIMIT_USER_BURST=120
# RATE_LIMIT_USER_REFILL_MS=250
# RATE_LIMIT_AUTH_BURST=8
# RATE_LIMIT_AUTH_REFILL_MS=60000
# RATE_LIMIT_SESSION_BURST=40
# RATE_LIMIT_SESSION_REFILL_MS=1500
# RATE_LIMIT_CONTACT_BURST=3
# RATE_LIMIT_CONTACT_REFILL_MS=180000
# RATE_LIMIT_RESET_BURST=3
# RATE_LIMIT_RESET_REFILL_MS=600000

# Database
DATABASE_URL=postgres://[user]:[password]@[host]:[port]/[database]

# JWT Configuration
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your-distinct-refresh-secret-change-this
JWT_REFRESH_EXPIRY=7d

# ===========================================
# FRONTEND URL - Automatically switches based on NODE_ENV
# ===========================================
# Development (default): http://localhost:3000
# Production: https://cosmoscraft.netlify.app
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_PROD=https://cosmoscraft.netlify.app

# ===========================================
# OAuth - Google
# ===========================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Development callback
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
# Production callback (used automatically when NODE_ENV=production)
GOOGLE_CALLBACK_URL_PROD=https://your-production-server.com/auth/google/callback

# ===========================================
# Email Service (Brevo)
# ===========================================
# Get your API key from Brevo dashboard: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key
# Sender email - must be on a domain verified in Brevo (Settings > Senders, Domains & Dedicated IPs > Domains)
MAIL_FROM=noreply@cosmos-craft.com
# Sender display name
MAIL_FROM_NAME=CosmosCraft
# Optional: number of send retries with backoff
MAIL_SEND_RETRIES=3
